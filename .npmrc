# Supply-chain hardening: never run dependency lifecycle scripts
# (preinstall / install / postinstall / prepare) on install.
# Explicitly invoked scripts (`npm run <name>`, `npm test`) are unaffected.
#
# npm 11 has no package.json field for this — `ignore-scripts` is npm config only.
# On npm 12+ dependency scripts are blocked by default and exceptions go in the
# package.json "allowScripts" field; see `npm help install-scripts`.
ignore-scripts=true
