{
  "name": "key-layout-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "biome-fix": "biome check --write src",
    "build": "dpdm --tree false --exit-code circular:1 src && tsc -b && vite build && npx tsx scripts/generate-seo-content.ts",
    "preview": "vite preview",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "tests": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "circularity-check": "dpdm --tree false src",
    "update-interactive": "npm-check-updates -i"
  },
  "dependencies": {
    "@kcf-hub/kle-serial": "0.17.0",
    "@preact/signals": "2.11.1",
    "posthog-js": "1.418.6",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/preact": "3.2.4",
    "@types/node": "26.1.2",
    "dpdm": "4.3.0",
    "jsdom": "30.0.1",
    "npm-check-updates": "23.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "tsx": "4.23.12"
  }
}
